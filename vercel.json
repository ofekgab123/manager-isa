{
  "version": 2,
  "buildCommand": "cd server && npm install && cd ../dashboard && npm install && npm run build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
