{
  "version": 2,
  "buildCommand": "cd server && npm install && cd ../dashboard && npm install && npm run build",
  "framework": null,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
