{
  "name": "manager-isa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "scripts": {
    "server": "cd server && npm run dev",
    "dashboard": "cd dashboard && npm run dev",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run server\" \"npm run dashboard\"",
    "dev:full": "npm run build && node run-local.js",
    "install:all": "cd server && npm install && cd ../dashboard && npm install",
    "build": "cd dashboard && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
