{
  "name": "manager-isa-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db:init": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "db:ping": "node --env-file-if-exists=.env scripts/db-ping.mjs",
    "db:migrate": "node --env-file-if-exists=.env migrate-data.js",
