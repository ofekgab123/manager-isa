# Make.com / LionWheel → עדכון סטטוס במשימה (lionwheel.taskStatus במסד)
#
# מומלץ לגוף מלא מ-LionWheel:
# • URL:    {BASE_URL}/api/webhooks/lionwheel-task
#
# גם עובד (אותה לוגיקה):
# • URL:    {BASE_URL}/api/webhooks/make-lionwheel-status
#
# Method: POST
# Headers:
#     Content-Type: application/json
#     Authorization: Bearer … (ברירת מחדל בשרת — .env: MAKE_LIONWHEEL_WEBHOOK_SECRET)
#
# פורט ברירת מחדל מקומית: 3002 (ראה server/index.js).

@baseUrl = http://localhost:3002
@secret = lionnwheelhttp12313ff

### מומלץ — גוף webhook מלא כמו מ-LionWheel (task.id + task.status + task.order_id)
POST {{baseUrl}}/api/webhooks/lionwheel-task
Authorization: Bearer {{secret}}
Content-Type: application/json

{
  "task": {
    "id": 24309382,
    "status": "ACTIVE",
    "order_id": "MSN-1777403712006"
  },
  "trigger_field": "status"
}

### דוגמה קצרה — מזהה משימת LW + סטטוס מספרי (0–10)
POST {{baseUrl}}/api/webhooks/lionwheel-task
Authorization: Bearer {{secret}}
Content-Type: application/json

{
  "task_id": 12345678,
  "status": 2
}

### דוגמה — taskId על השורש + סטטוס כמחרוזת
POST {{baseUrl}}/api/webhooks/lionwheel-task
Authorization: Bearer {{secret}}
Content-Type: application/json

{
  "taskId": 12345678,
  "status": "COMPLETED"
}

### חילוץ שדות (שרת — lionwheel.js → extractLionWheelWebhookFields)
# סטטוס: חובה — מספר או מחרוזת LionWheel (UNASSIGNED, ASSIGNED, ACTIVE, CANCELED, …).
# משימה: מ-task.id (או task_id בשורש) — מתאים ל-mission.lionwheel.taskId.
# גיבוי: task.order_id (MSN-…) או mission_id בשורש — מתאים ל-mission.id.

### דיבוג — מה Make באמת שולח (לא מעדכן משימות)
# כתובת ב-Make: POST {BASE_URL}/api/webhooks/make-inspect
# אותו Bearer כמו למעלה (או MAKE_WEBHOOK_INSPECT_SECRET ב-.env).
# תגובה: JSON עם id; צפייה ברשימה (אדמין + JWT): GET /api/debug/make-webhook-inspect-log
POST {{baseUrl}}/api/webhooks/make-inspect
Authorization: Bearer {{secret}}
Content-Type: application/json

{
  "anything": "from Make",
  "nested": { "task_id": 999 }
}
